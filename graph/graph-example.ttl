@prefix : <http://example.org/minecraft-mods#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/minecraft-mods> rdf:type owl:Ontology ;
    rdfs:label "Minecraft Mods Knowledge Graph" .


# Classes
:Mod rdf:type owl:Class ; rdfs:label "Мод"@ru .
:Release rdf:type owl:Class ; rdfs:label "Релиз мода"@ru .
:Loader rdf:type owl:Class ; rdfs:label "Загрузчик модов"@ru .
:GameVersion rdf:type owl:Class ; rdfs:label "Версия игры"@ru .
:Repository rdf:type owl:Class ; rdfs:label "Репозиторий кода"@ru .

:Developer rdf:type owl:Class ; rdfs:label "Разработчик"@ru .
:Person rdf:type owl:Class ; rdfs:subClassOf :Developer ; rdfs:label "Человек"@ru .
:Team rdf:type owl:Class ; rdfs:subClassOf :Developer ; rdfs:label "Команда"@ru .

:Issue rdf:type owl:Class ; rdfs:label "Тикет"@ru .
:BugIssue rdf:type owl:Class ; rdfs:subClassOf :Issue ; rdfs:label "Баг-репорт"@ru .
:CompatibilityIssue rdf:type owl:Class ; rdfs:subClassOf :Issue ; rdfs:label "Проблема совместимости"@ru .


# Axioms
[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :Mod :Release :Loader :GameVersion :Developer :Repository :Issue ) .

[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :Person :Team ) .

[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :BugIssue :CompatibilityIssue ) .


# Object properties / Predicates
:hasRelease rdf:type owl:ObjectProperty ;
    owl:inverseOf :isReleaseOf ;
    rdfs:domain :Mod ;
    rdfs:range :Release .

:isReleaseOf rdf:type owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Release ;
    rdfs:range :Mod .

:developedBy rdf:type owl:ObjectProperty ;
    owl:inverseOf :develops ;
    rdfs:domain :Mod ;
    rdfs:range :Developer .

:develops rdf:type owl:ObjectProperty ;
    rdfs:domain :Developer ;
    rdfs:range :Mod .

:hasMember rdf:type owl:ObjectProperty ;
    rdfs:domain :Team ;
    rdfs:range :Person .

:hasRepository rdf:type owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Mod ;
    rdfs:range :Repository .

:supportsLoader rdf:type owl:ObjectProperty ;
    rdfs:domain :Release ;
    rdfs:range :Loader .

:supportsGameVersion rdf:type owl:ObjectProperty ;
    rdfs:domain :Release ;
    rdfs:range :GameVersion .

:dependsOn rdf:type owl:ObjectProperty ;
    rdfs:domain :Release ;
    rdfs:range :Mod ;
    owl:propertyDisjointWith :incompatibleWith .

:incompatibleWith rdf:type owl:ObjectProperty ;
    rdfs:domain :Release ;
    rdfs:range :Mod .

:hasIssue rdf:type owl:ObjectProperty ;
    owl:inverseOf :isIssueOf ;
    rdfs:domain :Repository ;
    rdfs:range :Issue .

:isIssueOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Issue ;
    rdfs:range :Repository .

:mentionsMod rdf:type owl:ObjectProperty ;
    rdfs:domain :Issue ;
    rdfs:range :Mod .


# Data properties / Attributes
:name rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

:description rdf:type owl:DatatypeProperty ;
    rdfs:domain :Mod ;
    rdfs:range xsd:string .

:hostedOn rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :Mod :Release )
                ] ;
    rdfs:range xsd:string .

:latestModVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain :Mod ;
    rdfs:range xsd:string .

:latestGameVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain :Mod ;
    rdfs:range xsd:string .

:versionString rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :Release :GameVersion )
                ] ;
    rdfs:range xsd:string .

:majorVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain :GameVersion ;
    rdfs:range xsd:integer .

:minorVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain :GameVersion ;
    rdfs:range xsd:integer .

:patchVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain :GameVersion ;
    rdfs:range xsd:integer .

:issueTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Issue ;
    rdfs:range xsd:string .

:issueNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Issue ;
    rdfs:range xsd:integer .

:issueStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain :Issue ;
    rdfs:range xsd:string .

:projectUrl rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :Mod :Repository )
                ] ;
    rdfs:range xsd:anyURI .

:slug rdf:type owl:DatatypeProperty ;
    rdfs:domain :Mod ;
    rdfs:range xsd:string .

:curseforgeId rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :Mod :Release )
                ] ;
    rdfs:range xsd:integer .

:modrinthId rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :Mod :Release )
                ] ;
    rdfs:range xsd:string .

:releaseDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Release ;
    rdfs:range xsd:dateTime .


# Instances / Examples
:Forge rdf:type :Loader ; :name "Forge"^^xsd:string .
:Fabric rdf:type :Loader ; :name "Fabric"^^xsd:string .
:NeoForge rdf:type :Loader ; :name "NeoForge"^^xsd:string .
:Quilt rdf:type :Loader ; :name "Quilt"^^xsd:string .

:MC_1_19_2 rdf:type :GameVersion ; 
    :versionString "1.19.2"^^xsd:string ;
    :majorVersion 1 ;
    :minorVersion 19 ;
    :patchVersion 2 .

:MC_1_20_1 rdf:type :GameVersion ; 
    :versionString "1.20.1"^^xsd:string ;
    :majorVersion 1 ;
    :minorVersion 20 ;
    :patchVersion 1 .

:Vazkii rdf:type :Person ;
    :name "Vazkii"^^xsd:string .

:DarkhaxDev rdf:type :Person ;
    :name "DarkhaxDev"^^xsd:string .

:jellysquid3 rdf:type :Person ;
    :name "jellysquid3"^^xsd:string .

:CaffeineMC rdf:type :Team ;
    :name "CaffeineMC"^^xsd:string ;
    :hasMember :jellysquid3 .

:AutoRegLib rdf:type :Mod ;
    :name "AutoRegLib"^^xsd:string ;
    :description "A library to ease menial tasks in mod development."^^xsd:string ;
    :hostedOn "CurseForge"^^xsd:string ;
    :latestModVersion "1.8.2-55"^^xsd:string ;
    :latestGameVersion "1.19.2"^^xsd:string ;
    :developedBy :Vazkii ;
    :hasRepository :Repo_AutoRegLib .

:Bookshelf rdf:type :Mod ;
    :name "Bookshelf"^^xsd:string ;
    :developedBy :DarkhaxDev .

:EnchantmentDescriptions rdf:type :Mod ;
    :name "Enchantment Descriptions"^^xsd:string ;
    :description "Adds in-game descriptions for enchantments to tooltips."^^xsd:string ;
    :hostedOn "CurseForge"^^xsd:string ;
    :latestModVersion "13.0.20"^^xsd:string ;
    :latestGameVersion "1.19.2"^^xsd:string ;
    :developedBy :DarkhaxDev ;
    :hasRepository :Repo_EnchDesc .

:OptiFine rdf:type :Mod ;
    :name "OptiFine"^^xsd:string .

:Sodium rdf:type :Mod ;
    :name "Sodium"^^xsd:string ;
    :developedBy :CaffeineMC ;
    :hostedOn "Modrinth"^^xsd:string ;
    :hostedOn "CurseForge"^^xsd:string ;
    :latestModVersion "0.4.10"^^xsd:string ;
    :latestGameVersion "1.19.2"^^xsd:string ;
    :hasRepository :Repo_Sodium .

:Rel_AutoRegLib_1_8_2_55 rdf:type :Release ;
    :isReleaseOf :AutoRegLib ;
    :versionString "1.8.2-55"^^xsd:string ;
    :supportsLoader :Forge ;
    :supportsGameVersion :MC_1_19_2 .

:Rel_EnchDesc_Forge_1_19_2 rdf:type :Release ;
    :isReleaseOf :EnchantmentDescriptions ;
    :versionString "13.0.20"^^xsd:string ;
    :supportsLoader :Forge ;
    :supportsGameVersion :MC_1_19_2 ;
    :dependsOn :Bookshelf .

:Rel_Sodium_0_4_10 rdf:type :Release ;
    :isReleaseOf :Sodium ;
    :versionString "0.4.10"^^xsd:string ;
    :supportsLoader :Fabric ;
    :supportsGameVersion :MC_1_19_2 ;
    :incompatibleWith :OptiFine .

:Repo_Sodium rdf:type :Repository ;
    :projectUrl "https://github.com/CaffeineMC/sodium-fabric"^^xsd:anyURI ;
    :hasIssue :Issue_142 .

:Repo_AutoRegLib rdf:type :Repository ;
    :projectUrl "https://github.com/Vazkii/AutoRegLib"^^xsd:anyURI .

:Repo_EnchDesc rdf:type :Repository ;
    :projectUrl "https://github.com/Darkhax-Minecraft/Enchantment-Descriptions"^^xsd:anyURI ;
    :hasIssue :Issue_89 .

:Issue_89 rdf:type :CompatibilityIssue ;
    :issueTitle "OptiFine tooltip overlap glitch"^^xsd:string ;
    :issueNumber 89 ;
    :issueStatus "open"^^xsd:string ;
    :mentionsMod :OptiFine .

:Issue_142 rdf:type :CompatibilityIssue ;
    :issueTitle "Crash with OptiFine when chunks load"^^xsd:string ;
    :issueNumber 142 ;
    :issueStatus "closed"^^xsd:string ;
    :mentionsMod :OptiFine .